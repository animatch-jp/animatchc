rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── v11（2026-11-01）：里親募集・ボランティア募集は、運営が承認した団体だけが、自分の団体名で投稿できる。
    //    「興味あります」を押した人は、その団体だけが見られる。名前を偽れない ──
    // ── v10（2026-11-01）：ブロックを悪用されないようにした。だれがだれをブロックしたかを、ほかの人が見られない。
    //    ブロックされた人は、1対1のチャットにメッセージを送れない。チャットのメッセージは、送り主を偽れない・他人のメッセージを書きかえられない ──
    // ── v9（2026-11-01）：ペット自慢の票を、1人1票より多く増やせないようにした ──
    // ── v8（2026-11-01）：運営（admins）ができることを足し、イベントのチャットを安全にした ──

    // 運営（admins に入っている人）かどうか
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // イベントの参加者か主催者かどうか
    function isEventMember(eventId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid
      );
    }

    // ペット自慢の投票：「投票した記録（voters）」を、いま同時に作るときだけ、
    // その部門の票と合計を、ちょうど1つ増やせる
    function voteOk(postId) {
      let vpath = /databases/$(database)/documents/petBrags/$(postId)/voters/$(request.auth.uid);
      let t = getAfter(vpath).data.voteType;
      let before = resource.data.get('votes', {});
      let after = request.resource.data.get('votes', {});
      return !exists(vpath) && existsAfter(vpath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'voteCount'])
        && request.resource.data.voteCount == resource.data.get('voteCount', 0) + 1
        && after.diff(before).affectedKeys().hasOnly([t])
        && after.get(t, 0) == before.get(t, 0) + 1;
    }

    // ペット自慢のコメント数：1つずつ増やす・減らすだけ
    function commentCountOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (request.resource.data.commentCount - resource.data.get('commentCount', 0)) in [-1, 1];
    }

    // ── 年齢・キャンセル回数・参加停止を、アプリからの書き換えで変えられないようにする部品 ──

    // 生年月日（'YYYY-MM-DD'）から、日本時間での今の年齢を出す
    function ageFrom(b) {
      let jst = request.time + duration.time(9, 0, 0, 0);
      let p = b.split('-');
      let y = int(p[0]);
      let m = int(p[1]);
      let d = int(p[2]);
      return jst.year() - y - ((jst.month() < m || (jst.month() == m && jst.day() < d)) ? 1 : 0);
    }

    // 書き込み後の生年月日と、書こうとしている年齢が合っているか
    function ageValid(uid) {
      let bpath = /databases/$(database)/documents/users/$(uid)/private/birth;
      return existsAfter(bpath)
        && request.resource.data.age == ageFrom(getAfter(bpath).data.birthDate);
    }

    // キャンセル回数は、1回ぶんしか増やせない（減らす・リセットは不可）
    function cancelOk() {
      return request.resource.data.cancelCount == resource.data.get('cancelCount', 0) + 1;
    }

    // 参加停止の期限は、これから25時間以内の未来にだけ設定できる。短くする・消すことは不可
    function suspendOk() {
      return 'eventSuspendedUntil' in request.resource.data
        && request.resource.data.eventSuspendedUntil is timestamp
        && request.resource.data.eventSuspendedUntil > request.time
        && request.resource.data.eventSuspendedUntil <= request.time + duration.time(25, 0, 0, 0)
        && (!('eventSuspendedUntil' in resource.data)
            || request.resource.data.eventSuspendedUntil >= resource.data.eventSuspendedUntil);
    }

    // 回答の「役に立った」は、誰でも押せる。ただし、増やせるのも減らせるのも、自分のIDだけ
    function helpfulOk() {
      let before = resource.data.get('helpfulBy', []).toSet();
      let after = request.resource.data.helpfulBy.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulBy'])
        && after.difference(before).hasOnly([request.auth.uid])
        && before.difference(after).hasOnly([request.auth.uid]);
    }

    match /{path=**}/liked/{targetId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/favorited/{targetId} {
      allow read: if request.auth != null;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('age' in request.resource.data) || ageValid(userId));
      // 本人：自分のプロフィールを直せる。ただし「一時停止」は自分では変えられない
      // 運営：「一時停止」と、その日時だけ変えられる
      allow update: if (request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended', 'suspendedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['age'])
            || ageValid(userId))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cancelCount'])
            || cancelOk())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['eventSuspendedUntil'])
            || suspendOk()))
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedAt']));
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      match /pets/{petId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /tasks/{taskId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && request.auth.uid == userId;

          match /logs/{logId} {
            allow read: if request.auth != null;
            allow write: if request.auth != null && request.auth.uid == userId;
          }
        }
      }
      match /searchHistory/{historyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /groupChatLastSeen/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // 生年月日（birth）は、最初の登録だけ。あとから書き換えられない
        allow create: if request.auth != null && request.auth.uid == userId;
        // （プロフィールがまだ無い人が、登録をやり直すときだけは、書き直せる）
        allow update: if request.auth != null && request.auth.uid == userId
          && (docId != 'birth' || !exists(/databases/$(database)/documents/users/$(userId)));
        // 生年月日は、アカウント本体と一緒に消すときだけ消せる
        allow delete: if request.auth != null && request.auth.uid == userId
          && (docId != 'birth' || !existsAfter(/databases/$(database)/documents/users/$(userId)));
      }
    }
    match /likes/{userId}/liked/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /favorites/{userId}/favorited/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // 1対1のチャット（チャットのIDは、2人のuidを並べて _ でつないだもの）に、自分が入っているか
    function inChat(chatId) {
      return request.auth != null && chatId.split('_').hasAny([request.auth.uid]);
    }
    // 相手にブロックされていないか（自分で自分はブロックできないので、2人とも調べてよい）
    function notBlockedInChat(chatId) {
      let p = chatId.split('_');
      return p.size() == 2
        && !exists(/databases/$(database)/documents/blocks/$(p[0])/blocked/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(p[1])/blocked/$(request.auth.uid));
    }
    match /chats/{chatId} {
      allow get: if inChat(chatId);
      allow list: if request.auth != null && request.auth.uid in resource.data.participants;
      // 新しく作るのと、最後のメッセージを書きかえるのは、ブロックされていないときだけ
      // （開いたときに自分の未読を0にするのは、ブロックされていてもできる）
      allow create: if inChat(chatId) && notBlockedInChat(chatId);
      allow update: if inChat(chatId) && (
        notBlockedInChat(chatId) ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['lastMessage', 'lastMessageAt', 'lastSenderId', 'participants'])
      );
      allow delete: if inChat(chatId);
      match /messages/{messageId} {
        allow read: if inChat(chatId);
        // 送り主は自分だけ。文字は1000字まで。相手にブロックされていたら送れない
        allow create: if inChat(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && notBlockedInChat(chatId);
        // 書きかえは「読んだ」の印だけ。相手のメッセージにだけつけられる
        allow update: if inChat(chatId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // アカウントを消すときに、チャットごと消すため
        allow delete: if inChat(chatId);
      }
    }
    match /blocks/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // 親の文書は、アカウントを消すときに消すだけ
      allow delete: if request.auth != null && request.auth.uid == userId;
      match /blocked/{blockedId} {
        // 自分のブロックの一覧は自分だけ。1件ずつなら、ブロックされた本人も
        // 「自分がブロックされているか」だけ確かめられる（チャットやプロフィールで使う）。運営も見られる
        allow list: if request.auth != null && request.auth.uid == userId;
        allow get: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == blockedId || isAdmin()
        );
        // ブロックするのは自分だけ。自分自身はブロックできない。中身は日時だけ
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /reports/{reportId} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /footprints/{userId}/visitors/{visitorId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == visitorId;
    }
    match /notifications/{userId}/items/{itemId} {
      // 自分あての通知だけ読める
      allow read: if request.auth != null && request.auth.uid == userId;
      // 通知を送る（作る）。送り主（senderUid または fromUid）が自分のときだけ。
      // 管理者からのお知らせは、管理者なら送れる
      allow create: if request.auth != null && (
        request.resource.data.get('senderUid',
          request.resource.data.get('fromUid', '')) == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      // 更新できるのは、①本人（既読にするなど） ②グループチャット通知の上書き（送り主が自分のとき）
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (itemId.matches('groupChat_.*') &&
          request.resource.data.fromUid == request.auth.uid)
      );
      // 削除できるのは本人だけ
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /contacts/{contactId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /reviews/{userId}/received/{reviewerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == reviewerId;
    }
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('age', 0) >= 18;
      allow update: if request.auth != null && (
        (resource.data.organizerUid == request.auth.uid
          && request.resource.data.organizerUid == resource.data.organizerUid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
          && (request.resource.data.participantCount - resource.data.participantCount) in [-1, 1])
      );
      allow delete: if request.auth != null && (
        resource.data.organizerUid == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && !(request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.get('bannedUsers', []))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('age', 0) >= 18;
        allow delete: if request.auth != null && (
          request.auth.uid == uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid
        );
      }
      match /messages/{messageId} {
        // 読める：参加者・主催者・運営（通報の確認のため）
        allow read: if isEventMember(eventId) || isAdmin();
        // 送れる：参加者・主催者。送り主は自分の名前でだけ（「〜さんが参加しました」のお知らせは例外）
        allow create: if isEventMember(eventId) && (
          request.resource.data.senderUid == request.auth.uid ||
          (request.resource.data.get('isSystem', false) == true
            && request.resource.data.senderUid == 'system')
        );
        // 変えられる：自分のメッセージ。ほかの人のメッセージは、リアクションだけ
        allow update: if isEventMember(eventId) && (
          resource.data.senderUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        );
        // 消せる：自分のメッセージ・主催者・運営
        allow delete: if request.auth != null && (
          resource.data.senderUid == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid ||
          isAdmin()
        );
      }
      match /cancellations/{cancelId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
    match /petBrags/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      // 変えられるのは、票（voteOk）と、コメントの数（commentCountOk）だけ
      allow update: if request.auth != null && (commentCountOk() || voteOk(postId));
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      match /voters/{voterId} {
        allow read: if request.auth != null;
        // 1人1回だけ。あとから消したり書きかえたりはできない（消して入れ直すズルを防ぐ）
        allow create: if request.auth != null && request.auth.uid == voterId
          && request.resource.data.voteType in ['kawaii', 'omoshiroi', 'iyashi'];
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.uid ||
          request.auth.uid == get(/databases/$(database)/documents/petBrags/$(postId)).data.uid ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
      }
    }
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == orgId;
      allow update: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.uid == orgId &&
         request.resource.data.status == resource.data.status)
      );
      allow delete: if request.auth != null && request.auth.uid == orgId;
    }
    // 運営が承認した団体か（承認前の団体や、ふつうの利用者は、団体として投稿できない）
    function isApprovedOrg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/organizations/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.status == 'approved';
    }
    // 団体名は、その団体の本当の名前だけ（ほかの団体になりすませない）
    function myOrgName() {
      return get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.name;
    }
    // 文字の項目が、なし か、文字で n 字まで
    function strMax(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function adoptionOk(d) {
      return strMax(d, 'petName', 20) && strMax(d, 'type', 30) && strMax(d, 'age', 15)
        && strMax(d, 'personality', 500) && strMax(d, 'background', 800)
        && strMax(d, 'conditions', 500) && strMax(d, 'imageUrl', 500);
    }
    function volunteerOk(d) {
      return strMax(d, 'title', 40) && strMax(d, 'location', 50) && strMax(d, 'area', 10)
        && strMax(d, 'schedule', 50) && strMax(d, 'description', 800) && strMax(d, 'imageUrl', 500);
    }
    match /adoptions/{adoptionId} {
      allow read: if request.auth != null;
      allow create: if isApprovedOrg()
        && request.resource.data.orgId == request.auth.uid
        && request.resource.data.orgName == myOrgName()
        && adoptionOk(request.resource.data);
      // 書きかえは自分の投稿だけ。だれの投稿か（orgId・orgName）は変えられない
      allow update: if request.auth != null && request.auth.uid == resource.data.orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.orgName == resource.data.orgName
        && adoptionOk(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.orgId || isAdmin());
    }
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null;
      allow create: if isApprovedOrg()
        && request.resource.data.orgId == request.auth.uid
        && request.resource.data.orgName == myOrgName()
        && volunteerOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == resource.data.orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.orgName == resource.data.orgName
        && volunteerOk(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.orgId || isAdmin());

      // 「興味あります」：だれが押したかは、その団体（と運営）だけが見られる。押した本人は自分の分だけ
      match /interested/{uid} {
        allow get: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.orgId ||
          isAdmin()
        );
        allow list: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.orgId ||
          isAdmin()
        );
        // 押すのは自分の分だけ。名前は自分のプロフィールの名前だけ（ほかの人になりすませない）
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name ==
               get(/databases/$(database)/documents/users/$(uid)).data.get('name', '名無しさん')
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.orgId
        );
      }
    }
    match /lostPets/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /hospitals/{hospitalId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == hospitalId;
      allow update: if request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.uid == hospitalId &&
         request.resource.data.status == resource.data.status)
      );
      allow delete: if request.auth != null && request.auth.uid == hospitalId;

      match /tagVotes/{voteId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == voteId;
      }
    }
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      // 消せる：本人と運営（通報された質問を消すため）
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());

      match /answers/{answerId} {
        allow read: if request.auth != null;
        // 回答を作るとき、「役に立った」は空で始める（最初から票を入れておけない）
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
          && request.resource.data.get('helpfulBy', []).size() == 0;
        // 回答への更新は「役に立った」の付け外しだけ。自分の回答には付けられない
        allow update: if request.auth != null
          && request.auth.uid != resource.data.uid
          && helpfulOk();
        // 消せる：本人と運営（通報された回答を消すため）
        allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      }
    }
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}