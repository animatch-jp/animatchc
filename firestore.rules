rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── v12（2026-11-02）：①メール・通知の鍵・性別を、みんなが読めるプロフィールに置けない（本人と運営だけが読める private へ）
    //    ②団体・病院は「審査待ち」でしか登録できない。団体名・病院名・審査の状態は自分で変えられない
    //    ③ペット自慢は票0から。迷子・質問・回答・コメント・イベント・通報・お問い合わせ・通知に文字数の上限
    //    ④「公式」イベント・団体の迷子の印・運営からの通知は、本当の運営・団体だけ ⑤使っていない場所（reviews）を閉じる ──
    // ── v11（2026-11-01）：里親募集・ボランティア募集は、運営が承認した団体だけが、自分の団体名で投稿できる。
    //    「興味あります」を押した人は、その団体だけが見られる。名前を偽れない ──
    // ── v10（2026-11-01）：ブロックを悪用されないようにした。だれがだれをブロックしたかを、ほかの人が見られない。
    //    ブロックされた人は、1対1のチャットにメッセージを送れない。チャットのメッセージは、送り主を偽れない・他人のメッセージを書きかえられない ──
    // ── v9（2026-11-01）：ペット自慢の票を、1人1票より多く増やせないようにした ──
    // ── v8（2026-11-01）：運営（admins）ができることを足し、イベントのチャットを安全にした ──

    // 運営（admins に入っている人）かどうか
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // イベントの参加者か主催者かどうか
    function isEventMember(eventId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid
      );
    }

    // ペット自慢の投票：「投票した記録（voters）」を、いま同時に作るときだけ、
    // その部門の票と合計を、ちょうど1つ増やせる
    function voteOk(postId) {
      let vpath = /databases/$(database)/documents/petBrags/$(postId)/voters/$(request.auth.uid);
      let t = getAfter(vpath).data.voteType;
      let before = resource.data.get('votes', {});
      let after = request.resource.data.get('votes', {});
      return !exists(vpath) && existsAfter(vpath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'voteCount'])
        && request.resource.data.voteCount == resource.data.get('voteCount', 0) + 1
        && after.diff(before).affectedKeys().hasOnly([t])
        && after.get(t, 0) == before.get(t, 0) + 1;
    }

    // ペット自慢のコメント数：1つずつ増やす・減らすだけ
    function commentCountOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (request.resource.data.commentCount - resource.data.get('commentCount', 0)) in [-1, 1];
    }

    // ── 年齢・キャンセル回数・参加停止を、アプリからの書き換えで変えられないようにする部品 ──

    // 生年月日（'YYYY-MM-DD'）から、日本時間での今の年齢を出す
    function ageFrom(b) {
      let jst = request.time + duration.time(9, 0, 0, 0);
      let p = b.split('-');
      let y = int(p[0]);
      let m = int(p[1]);
      let d = int(p[2]);
      return jst.year() - y - ((jst.month() < m || (jst.month() == m && jst.day() < d)) ? 1 : 0);
    }

    // ほかの人に見せる年代（'10代'・'20代'…）。くわしい年齢はプロフィールに置かない
    function ageGroupFrom(b) {
      let a = ageFrom(b);
      return a < 10 ? '10歳未満' : string(a - a % 10) + '代';
    }
    function ageGroupValid(uid) {
      let bpath = /databases/$(database)/documents/users/$(uid)/private/birth;
      return existsAfter(bpath)
        && request.resource.data.ageGroup == ageGroupFrom(getAfter(bpath).data.birthDate);
    }
    // 18歳以上か：本人しか読めない生年月日から計算する（前の版の age がある人は、それも見る）
    function isAdultUser(uid) {
      let bpath = /databases/$(database)/documents/users/$(uid)/private/birth;
      return (exists(bpath) && ageFrom(get(bpath).data.birthDate) >= 18)
        || get(/databases/$(database)/documents/users/$(uid)).data.get('age', 0) >= 18;
    }


    // キャンセル回数は1つずつしか増やせない。増やすときは、最後にキャンセルした日時もいっしょに記録する
    function cancelOk() {
      return request.resource.data.cancelCount == resource.data.get('cancelCount', 0) + 1
        && request.resource.data.lastCancelAt == request.time;
    }
    // 最後のキャンセルから90日たったら、回数を0に戻せる（前の版で記録した日時がない人も戻せる）
    function cancelResetOk() {
      return request.resource.data.cancelCount == 0
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastCancelAt'])
        && (!('lastCancelAt' in resource.data)
            || request.time > resource.data.lastCancelAt + duration.value(90, 'd'));
    }

    // 参加停止の期限は、これから25時間以内の未来にだけ設定できる。短くする・消すことは不可
    function suspendOk() {
      return 'eventSuspendedUntil' in request.resource.data
        && request.resource.data.eventSuspendedUntil is timestamp
        && request.resource.data.eventSuspendedUntil > request.time
        && request.resource.data.eventSuspendedUntil <= request.time + duration.time(25, 0, 0, 0)
        && (!('eventSuspendedUntil' in resource.data)
            || request.resource.data.eventSuspendedUntil >= resource.data.eventSuspendedUntil);
    }

    // 回答の「役に立った」は、誰でも押せる。ただし、増やせるのも減らせるのも、自分のIDだけ
    function helpfulOk() {
      let before = resource.data.get('helpfulBy', []).toSet();
      let after = request.resource.data.helpfulBy.toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulBy'])
        && after.difference(before).hasOnly([request.auth.uid])
        && before.difference(after).hasOnly([request.auth.uid]);
    }

    // 文字の項目が、なし か、文字で n 字まで（strMax はあとでも使う）
    function strMax(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    // 書きかえた項目だけを調べる（前からある長い文があっても、ほかの更新を止めない）
    function changed(k) {
      return k in request.resource.data.diff(resource.data).affectedKeys();
    }
    function strMaxIfChanged(k, n) {
      return !changed(k) || strMax(request.resource.data, k, n);
    }
    // メールと通知の鍵は、新しく置いたり変えたりできない（消すのはよい。前の版のデータを移すため）
    function noNewSecret(k) {
      return !(k in request.resource.data)
        || (k in resource.data && request.resource.data[k] == resource.data[k]);
    }
    // 運営や公式のふりをする名前は使えない（アプリの「名前のきまり」と同じ言葉）
    function nameOk(n) {
      return n is string && !n.lower().replace('\\s', '').matches('.*(運営|公式|管理者|スタッフ|animatch|アニマッチ|admin|official|staff).*');
    }
    function profileOk() {
      return (!changed('name') || nameOk(request.resource.data.name))
        && strMaxIfChanged('name', 20) && strMaxIfChanged('bio', 300) && strMaxIfChanged('motto', 30)
        && strMaxIfChanged('prefecture', 10) && strMaxIfChanged('animal', 200) && strMaxIfChanged('gender', 20)
        && strMaxIfChanged('relation', 20) && strMaxIfChanged('profileImageUrl', 500)
        && (!changed('interests') || (request.resource.data.interests is list && request.resource.data.interests.size() <= 20))
        && (!changed('spots') || (request.resource.data.spots is list && request.resource.data.spots.size() <= 20));
    }

    match /{path=**}/liked/{targetId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/favorited/{targetId} {
      allow read: if request.auth != null;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('ageGroup' in request.resource.data) || ageGroupValid(userId))
        && !request.resource.data.keys().hasAny(['age', 'email', 'fcmToken', 'gender', 'suspended', 'suspendedAt', 'cancelCount', 'lastCancelAt', 'eventSuspendedUntil'])
        && strMax(request.resource.data, 'name', 20) && strMax(request.resource.data, 'bio', 300)
        && strMax(request.resource.data, 'motto', 30)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1
        && nameOk(request.resource.data.name);
      // 本人：自分のプロフィールを直せる。ただし「一時停止」は自分では変えられない
      // 運営：「一時停止」と、その日時だけ変えられる
      allow update: if (request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended', 'suspendedAt'])
        && noNewSecret('email') && noNewSecret('fcmToken') && noNewSecret('gender') && noNewSecret('age')
        && profileOk()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ageGroup'])
            || ageGroupValid(userId))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cancelCount', 'lastCancelAt'])
            || cancelOk() || cancelResetOk())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['eventSuspendedUntil'])
            || suspendOk()))
        || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedAt']));
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      match /pets/{petId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;

        // 毎日のお世話（ごはん・散歩など）は、本人だけが読める
        match /tasks/{taskId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
          allow create, update: if request.auth != null && request.auth.uid == userId
            && strMax(request.resource.data, 'name', 30);

          match /logs/{logId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow write: if request.auth != null && request.auth.uid == userId;
          }
        }
      }
      // 記録帳（体重・ワクチン・薬・通院・メモ）は、本人だけが読める・書ける
      function recordOk(d) {
        return d.keys().hasOnly(['kind', 'date', 'weight', 'note', 'nextDate', 'createdAt', 'updatedAt'])
          && d.kind in ['weight', 'vaccine', 'medicine', 'hospital', 'other']
          && d.date is timestamp
          && strMax(d, 'note', 200)
          && (!('weight' in d) || (d.weight is number && d.weight > 0 && d.weight <= 200))
          && (!('nextDate' in d) || d.nextDate is timestamp);
      }
      match /pets/{petId}/records/{recordId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && recordOk(request.resource.data);
      }
      match /searchHistory/{historyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /groupChatLastSeen/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // 生年月日（birth）は、最初の登録だけ。あとから書き換えられない
        allow create: if request.auth != null && request.auth.uid == userId;
        // （プロフィールがまだ無い人が、登録をやり直すときだけは、書き直せる）
        allow update: if request.auth != null && request.auth.uid == userId
          && (docId != 'birth' || !exists(/databases/$(database)/documents/users/$(userId)));
        // 生年月日は、アカウント本体と一緒に消すときだけ消せる
        allow delete: if request.auth != null && request.auth.uid == userId
          && (docId != 'birth' || !existsAfter(/databases/$(database)/documents/users/$(userId)));
      }
    }
    match /likes/{userId}/liked/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /favorites/{userId}/favorited/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // 1対1のチャット（チャットのIDは、2人のuidを並べて _ でつないだもの）に、自分が入っているか
    function inChat(chatId) {
      return request.auth != null && chatId.split('_').hasAny([request.auth.uid]);
    }
    // 相手にブロックされていないか（自分で自分はブロックできないので、2人とも調べてよい）
    function notBlockedInChat(chatId) {
      let p = chatId.split('_');
      return p.size() == 2
        && !exists(/databases/$(database)/documents/blocks/$(p[0])/blocked/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(p[1])/blocked/$(request.auth.uid));
    }
    match /chats/{chatId} {
      allow get: if inChat(chatId);
      allow list: if request.auth != null && request.auth.uid in resource.data.participants;
      // 新しく作るのと、最後のメッセージを書きかえるのは、ブロックされていないときだけ
      // （開いたときに自分の未読を0にするのは、ブロックされていてもできる）
      allow create: if inChat(chatId) && notBlockedInChat(chatId);
      allow update: if inChat(chatId) && (
        notBlockedInChat(chatId) ||
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['lastMessage', 'lastMessageAt', 'lastSenderId', 'participants'])
      );
      allow delete: if inChat(chatId);
      match /messages/{messageId} {
        allow read: if inChat(chatId);
        // 送り主は自分だけ。文字は1000字まで。相手にブロックされていたら送れない
        allow create: if inChat(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && notBlockedInChat(chatId);
        // 書きかえは「読んだ」の印だけ。相手のメッセージにだけつけられる
        allow update: if inChat(chatId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        // アカウントを消すときに、チャットごと消すため
        allow delete: if inChat(chatId);
      }
    }
    match /blocks/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // 親の文書は、アカウントを消すときに消すだけ
      allow delete: if request.auth != null && request.auth.uid == userId;
      match /blocked/{blockedId} {
        // 自分のブロックの一覧は自分だけ。1件ずつなら、ブロックされた本人も
        // 「自分がブロックされているか」だけ確かめられる（チャットやプロフィールで使う）。運営も見られる
        allow list: if request.auth != null && request.auth.uid == userId;
        allow get: if request.auth != null && (
          request.auth.uid == userId || request.auth.uid == blockedId || isAdmin()
        );
        // ブロックするのは自分だけ。自分自身はブロックできない。中身は日時だけ
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && blockedId != userId
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    // アプリを開いた日の記録（続けて使われているかを見るため）。読めるのは本人と運営、書けるのは本人だけ
    match /activity/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstDay', 'lastDay', 'days'])
        && request.resource.data.firstDay is string && request.resource.data.firstDay.size() == 10
        && request.resource.data.lastDay == request.resource.data.firstDay
        && request.resource.data.days is list && request.resource.data.days.size() == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDay', 'days'])
        && request.resource.data.lastDay is string && request.resource.data.lastDay.size() == 10
        && request.resource.data.days is list
        && request.resource.data.days.hasAll(resource.data.days)
        && request.resource.data.days.size() <= resource.data.days.size() + 1
        && request.resource.data.days.size() <= 3000;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /reports/{reportId} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      // 通報する人は自分の名前でだけ。文字数の上限つき
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid
        && strMax(request.resource.data, 'reason', 50) && strMax(request.resource.data, 'comment', 1000);
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /notifications/{userId}/items/{itemId} {
      // 自分あての通知だけ読める
      allow read: if request.auth != null && request.auth.uid == userId;
      // 通知を送る（作る）。送り主（senderUid または fromUid）が自分のときだけ。
      // 管理者からのお知らせは、管理者なら送れる
      // 審査の結果・運営の対応などの通知は、運営だけが送れる（運営になりすませない）。文字数の上限つき
      allow create: if request.auth != null && (
        isAdmin() || (
          request.resource.data.get('senderUid', request.resource.data.get('fromUid', '')) == request.auth.uid
          && !(request.resource.data.get('type', '') in ['orgApproved', 'orgRejected', 'orgUpdateReflected',
               'hospitalApproved', 'hospitalRejected', 'hospitalUpdateReflected', 'reportHandled', 'admin', 'announcement'])
          && strMax(request.resource.data, 'title', 100) && strMax(request.resource.data, 'desc', 300)
        )
      );
      // 更新できるのは、①本人（既読にするなど） ②グループチャット通知の上書き（送り主が自分のとき）
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (itemId.matches('groupChat_.*') &&
          request.resource.data.fromUid == request.auth.uid)
      );
      // 削除できるのは本人だけ
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /contacts/{contactId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create: if request.auth != null && request.resource.data.get('uid', '') == request.auth.uid
        && strMax(request.resource.data, 'title', 50) && strMax(request.resource.data, 'content', 2000)
        && strMax(request.resource.data, 'category', 30);
      allow update, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 恋愛アプリのころの「レビュー」：いまは使っていないので閉じる
    match /reviews/{userId}/received/{reviewerId} {
      allow read, write: if false;
    }
    function eventOk(d) {
      return strMax(d, 'title', 30) && strMax(d, 'description', 300) && strMax(d, 'location', 50)
        && strMax(d, 'category', 30) && strMax(d, 'organizerName', 30) && strMax(d, 'imageUrl', 500);
    }
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid
        && isAdultUser(request.auth.uid)
        && (request.resource.data.get('isOfficial', false) == false || isAdmin())
        && eventOk(request.resource.data);
      allow update: if request.auth != null && (
        (resource.data.organizerUid == request.auth.uid
          && request.resource.data.organizerUid == resource.data.organizerUid
          && (!changed('isOfficial') || isAdmin())
          && eventOk(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
          && (request.resource.data.participantCount - resource.data.participantCount) in [-1, 1])
      );
      allow delete: if request.auth != null && (
        resource.data.organizerUid == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && !(request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.get('bannedUsers', []))
          && isAdultUser(request.auth.uid);
        allow delete: if request.auth != null && (
          request.auth.uid == uid || isAdmin() ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid
        );
      }
      match /messages/{messageId} {
        // 読める：参加者・主催者・運営（通報の確認のため）
        allow read: if isEventMember(eventId) || isAdmin();
        // 送れる：参加者・主催者。送り主は自分の名前でだけ（「〜さんが参加しました」のお知らせは例外）
        allow create: if isEventMember(eventId) && (
          request.resource.data.senderUid == request.auth.uid ||
          (request.resource.data.get('isSystem', false) == true
            && request.resource.data.senderUid == 'system')
        ) && strMax(request.resource.data, 'text', 1000) && strMax(request.resource.data, 'senderName', 30);
        // 変えられる：自分のメッセージ（送り主は変えられない）。ほかの人のメッセージは、リアクションだけ
        allow update: if isEventMember(eventId) && (
          (resource.data.senderUid == request.auth.uid
            && request.resource.data.senderUid == resource.data.senderUid
            && strMax(request.resource.data, 'text', 1000)) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        );
        // 消せる：自分のメッセージ・主催者・運営
        allow delete: if request.auth != null && (
          resource.data.senderUid == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid ||
          isAdmin()
        );
      }
      // キャンセルの理由：書くのは本人だけ。読めるのは主催者・本人・運営
      match /cancellations/{cancelId} {
        allow read: if request.auth != null && (
          resource.data.uid == request.auth.uid || isAdmin() ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid
        );
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
          && strMax(request.resource.data, 'reason', 300);
        // イベントを消すときに、主催者と運営が中身も消せる
        allow delete: if request.auth != null && (isAdmin() ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid);
      }
    }
    // 投稿の数の上限をルールで守る：投稿の名前（ID）を決まった形にする
    // ・今日のテーマ：「自分_d_日付_1〜3」→ 1日3枚まで（アプリでは1枚。消して出し直す予備）
    // ・月のテーマ：「自分_m_月_1〜9」→ 1か月9枚まで（アプリでは5枚。消して出し直す予備）
    // 日付は、今日の前後1日まで（日本時間と世界の時間のずれのぶん）
    function dateKeyNearNow(k) {
      return k is string && k.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && timestamp.date(int(k[0:4]), int(k[5:7]), int(k[8:10])) > request.time - duration.value(2, 'd')
        && timestamp.date(int(k[0:4]), int(k[5:7]), int(k[8:10])) < request.time + duration.value(1, 'd');
    }
    function petBragSlotOk(id, d) {
      return dateKeyNearNow(d.get('dateKey', ''))
        && (
          (!('monthlyThemeKey' in d) && id.matches(request.auth.uid + '_d_' + d.dateKey + '_[1-3]'))
          || ('monthlyThemeKey' in d && d.monthlyThemeKey == d.dateKey[0:7]
              && id.matches(request.auth.uid + '_m_' + d.monthlyThemeKey + '_[1-9]'))
        );
    }
    match /petBrags/{postId} {
      allow read: if request.auth != null;
      // 票とコメントの数は、0から始める（最初から票を入れてランキングをずるできない）
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
        && request.resource.data.get('voteCount', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('votes', {}).values().hasOnly([0])
        && strMax(request.resource.data, 'petName', 20) && strMax(request.resource.data, 'comment', 100)
        && strMax(request.resource.data, 'imageUrl', 500)
        && petBragSlotOk(postId, request.resource.data);
      // 変えられるのは、票（voteOk）と、コメントの数（commentCountOk）だけ
      allow update: if request.auth != null && (commentCountOk() || voteOk(postId));
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      match /voters/{voterId} {
        allow read: if request.auth != null;
        // 1人1回だけ。あとから消したり書きかえたりはできない（消して入れ直すズルを防ぐ）
        allow create: if request.auth != null && request.auth.uid == voterId
          && request.resource.data.voteType in ['kawaii', 'omoshiroi', 'iyashi'];
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && strMax(request.resource.data, 'name', 30);
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.uid ||
          request.auth.uid == get(/databases/$(database)/documents/petBrags/$(postId)).data.uid ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
      }
    }
    function orgOk(d) {
      return strMax(d, 'name', 50) && strMax(d, 'activityDescription', 1000) && strMax(d, 'contactInfo', 100)
        && strMax(d, 'websiteUrl', 300) && strMax(d, 'area', 10) && strMax(d, 'imageUrl', 500)
        && strMax(d, 'nameUpdatePending', 50) && strMax(d, 'activityUpdatePending', 1000);
    }
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      // 登録は「審査待ち」だけ（自分で「承認ずみ」にして登録できない）。メールはここに置かない
      allow create: if request.auth != null && request.auth.uid == orgId
        && request.resource.data.status == 'pending'
        && !('email' in request.resource.data)
        && orgOk(request.resource.data);
      // 団体が自分で変えられるのは、連絡先・サイト・地域・写真と、運営に確かめてもらう「変更の申請」だけ
      // （団体名・活動内容・審査の状態は、運営が確かめてから変わる）
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == orgId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['contactInfo', 'websiteUrl', 'area', 'imageUrl', 'nameUpdatePending', 'activityUpdatePending', 'email'])
          && noNewSecret('email')
          && orgOk(request.resource.data))
      );
      allow delete: if request.auth != null && (request.auth.uid == orgId || isAdmin());
      // メールアドレスなど：団体本人と運営だけ
      match /private/{docId} {
        allow read: if request.auth != null && (request.auth.uid == orgId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == orgId;
      }
    }
    // 運営が承認した団体か（承認前の団体や、ふつうの利用者は、団体として投稿できない）
    function isApprovedOrg() {
      return request.auth != null
        && exists(/databases/$(database)/documents/organizations/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.status == 'approved';
    }
    // 団体名は、その団体の本当の名前だけ（ほかの団体になりすませない）
    function myOrgName() {
      return get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.name;
    }
    function adoptionOk(d) {
      return strMax(d, 'petName', 20) && strMax(d, 'type', 30) && strMax(d, 'age', 15)
        && strMax(d, 'personality', 500) && strMax(d, 'background', 800)
        && strMax(d, 'conditions', 500) && strMax(d, 'imageUrl', 500);
    }
    function volunteerOk(d) {
      return strMax(d, 'title', 40) && strMax(d, 'location', 50) && strMax(d, 'area', 10)
        && strMax(d, 'schedule', 50) && strMax(d, 'description', 800) && strMax(d, 'imageUrl', 500);
    }
    match /adoptions/{adoptionId} {
      allow read: if request.auth != null;
      allow create: if isApprovedOrg()
        && request.resource.data.orgId == request.auth.uid
        && request.resource.data.orgName == myOrgName()
        && adoptionOk(request.resource.data);
      // 書きかえは自分の投稿だけ。だれの投稿か（orgId・orgName）は変えられない
      allow update: if request.auth != null && request.auth.uid == resource.data.orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.orgName == resource.data.orgName
        && adoptionOk(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.orgId || isAdmin());
    }
    // 団体のお知らせ・活動報告：運営が確認した団体だけが出せる。だれの投稿か（orgId・orgName）は変えられない
    function orgPostOk(d) {
      return d.keys().hasOnly(['orgId', 'orgName', 'kind', 'text', 'imageUrl', 'createdAt', 'updatedAt'])
        && d.kind in ['news', 'report', 'event', 'help']
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 500
        && strMax(d, 'imageUrl', 500);
    }
    match /orgPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if isApprovedOrg()
        && request.resource.data.orgId == request.auth.uid
        && request.resource.data.orgName == myOrgName()
        && orgPostOk(request.resource.data);
      allow update: if isApprovedOrg() && request.auth.uid == resource.data.orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.orgName == resource.data.orgName
        && orgPostOk(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.orgId || isAdmin());
    }
    match /volunteers/{volunteerId} {
      allow read: if request.auth != null;
      allow create: if isApprovedOrg()
        && request.resource.data.orgId == request.auth.uid
        && request.resource.data.orgName == myOrgName()
        && volunteerOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == resource.data.orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.orgName == resource.data.orgName
        && volunteerOk(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.orgId || isAdmin());

      // 「興味あります」：だれが押したかは、その団体（と運営）だけが見られる。押した本人は自分の分だけ
      match /interested/{uid} {
        allow get: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.orgId ||
          isAdmin()
        );
        allow list: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.orgId ||
          isAdmin()
        );
        // 押すのは自分の分だけ。名前は自分のプロフィールの名前だけ（ほかの人になりすませない）
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name ==
               get(/databases/$(database)/documents/users/$(uid)).data.get('name', '名無しさん')
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.orgId
        );
      }
    }
    function lostOk(d) {
      return strMax(d, 'petName', 20) && strMax(d, 'animalType', 30) && strMax(d, 'location', 50)
        && strMax(d, 'date', 30) && strMax(d, 'description', 500) && strMax(d, 'contact', 100)
        && strMax(d, 'reward', 30) && strMax(d, 'imageUrl', 500) && strMax(d, 'posterName', 50)
        && strMax(d, 'area', 10)
        // 「団体」の印は、運営が承認した団体だけ
        && (d.get('isOrganization', false) == false || isApprovedOrg());
    }
    match /lostPets/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
        && lostOk(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid
        && lostOk(request.resource.data);
      // 消せる：本人と運営（通報された迷子情報を消すため）
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }
    function hospitalOk(d) {
      return strMax(d, 'name', 50) && strMax(d, 'address', 100) && strMax(d, 'access', 100)
        && strMax(d, 'businessHours', 100) && strMax(d, 'contactInfo', 100) && strMax(d, 'area', 10)
        && strMax(d, 'imageUrl', 500) && strMax(d, 'nameUpdatePending', 50)
        && (!('animalTags' in d) || (d.animalTags is list && d.animalTags.size() <= 30));
    }
    match /hospitals/{hospitalId} {
      allow read: if request.auth != null;
      // 登録は「審査待ち」だけ。メールはここに置かない
      allow create: if request.auth != null && request.auth.uid == hospitalId
        && request.resource.data.status == 'pending'
        && !('email' in request.resource.data)
        && hospitalOk(request.resource.data);
      // 病院が自分で変えられるのは、住所・時間・連絡先・設備・写真・休止と、運営に確かめてもらう「病院名の変更の申請」だけ
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == hospitalId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['address', 'access', 'businessHours', 'contactInfo', 'area', 'animalTags', 'acceptingNew',
                         'hasInpatient', 'hasCT', 'hasMRI', 'hasNightCare', 'isPaused', 'imageUrl', 'nameUpdatePending', 'email'])
          && noNewSecret('email')
          && hospitalOk(request.resource.data))
      );
      allow delete: if request.auth != null && (request.auth.uid == hospitalId || isAdmin());

      match /private/{docId} {
        allow read: if request.auth != null && (request.auth.uid == hospitalId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == hospitalId;
      }
      // 「この病院の口コミのタグ」：1人1つ。自分の分だけ
      match /tagVotes/{voteId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == voteId
          && (!('commentTags' in request.resource.data) || request.resource.data.commentTags.size() <= 20)
          && (!('verifiedAnimalTags' in request.resource.data) || request.resource.data.verifiedAnimalTags.size() <= 20);
      }
    }
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
        && strMax(request.resource.data, 'title', 50) && strMax(request.resource.data, 'body', 500)
        && strMax(request.resource.data, 'name', 30) && strMax(request.resource.data, 'imageUrl', 500);
      allow update: if request.auth != null && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid
        && strMax(request.resource.data, 'title', 50) && strMax(request.resource.data, 'body', 500);
      // 消せる：本人と運営（通報された質問を消すため）
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());

      match /answers/{answerId} {
        allow read: if request.auth != null;
        // 回答を作るとき、「役に立った」は空で始める（最初から票を入れておけない）
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid
          && request.resource.data.get('helpfulBy', []).size() == 0
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && strMax(request.resource.data, 'name', 30);
        // 回答への更新は「役に立った」の付け外しだけ。自分の回答には付けられない
        allow update: if request.auth != null
          && request.auth.uid != resource.data.uid
          && helpfulOk();
        // 消せる：本人と運営（通報された回答を消すため）
        allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
      }
    }
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}